{
    "compilerOptions": {
        "target": "ES2022",
        "module": "commonjs",
        "moduleResolution": "node10",
        "rootDir": "src",
        "outDir": "dist",
        "lib": ["ES2022"],
        "types": [],
        "declaration": true,
        "strict": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "noFallthroughCasesInSwitch": true,
        "ignoreDeprecations": "6.0"
    },
    "include": ["src/**/*.ts"]
}
